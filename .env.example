# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Deployment mode ──────────────────────────────────────────────────────────
# Caddy mode: set your public hostname (DNS must point here for Let's Encrypt)
APPROVAL_DOMAIN=approvals.example.com

# ── Omnissa Access — Service client (approvals API) ──────────────────────────
OMNISSA_BOOTSTRAP_URL=<tenant>.wss.workspaceone.com
OMNISSA_BOOTSTRAP_CLIENT_ID=<service-client-id>
OMNISSA_BOOTSTRAP_CLIENT_SECRET=

# ── First-run local admin account ────────────────────────────────────────────
# Auto-created on first startup when the user table is empty.
# Remove or leave blank to skip (OAuth2 login will still work if configured below).
OMNISSA_BOOTSTRAP_ADMIN_USERNAME=admin
OMNISSA_BOOTSTRAP_ADMIN_PASSWORD=
OMNISSA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ── Admin OAuth2 login (optional — Omnissa Access as OIDC IdP) ───────────────
# Blank CLIENT_ID = no OAuth2 client is registered at all: local sign-in only,
# and nothing contacts a tenant at startup. A CLIENT_ID set without ISSUER_URI
# leaves OAuth2 off and logs an error — the pair is what names a tenant.
# Required Omnissa Access client config:
#   Type: User Access Token (Confidential)
#   Grant: Authorization Code + PKCE
#   Scopes: openid email profile group
#   Redirect URI: https://approvals.example.com/login/oauth2/code/omnissa
OMNISSA_ADMIN_OAUTH_CLIENT_ID=
OMNISSA_ADMIN_OAUTH_CLIENT_SECRET=
OMNISSA_ADMIN_OAUTH_REDIRECT_URI=https://approvals.example.com/login/oauth2/code/omnissa
OMNISSA_ADMIN_OAUTH_ISSUER_URI=
# Set to true to automatically disable the Omnissa Access consent screen on the OIDC
# client above. Requires ApprovalService to have admin rights. Leave false on first run
# (a tip will appear in the logs); enable once you have confirmed login works.
OMNISSA_ADMIN_OAUTH_DISABLE_CONSENT=false

# ── SSL (standalone mode only — not needed with Caddy) ───────────────────────
# Password for config/keystore.p12
# Run scripts/import-cert.sh or scripts/gen-dev-cert.sh to create the keystore.
SSL_KEYSTORE_PASSWORD=changeit

# ── SMTP (optional — for approval email notifications) ───────────────────────
# Blank host = no mail sender. Decisions still work; each one logs a warning
# saying the requester was not e-mailed, so it never passes for "sent".
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── Callout endpoint security (#70) ──────────────────────────────────────────
# REQUIRED once OMNISSA_BOOTSTRAP_URL names a tenant. Enter the same values in
# the Access console under Settings > Approvals. Without these (or the
# acknowledgement below) the container refuses to start: POST /api/approvals/new
# faces the internet, and anything reaching it can otherwise place requests in
# the queue that are indistinguishable from real ones.
OMNISSA_API_USERNAME=
OMNISSA_API_PASSWORD=
# Accept unauthenticated callouts anyway. Only where the endpoint truly cannot be
# reached from anywhere untrusted; warns hourly while set.
#OMNISSA_API_ALLOW_UNAUTHENTICATED=false
# How many reverse proxies sit in front of this container. Rate limits and the
# login throttle count X-Forwarded-For entries FROM THE RIGHT, because proxies
# append and the leftmost entry is written by the caller. 0 believes nothing in
# the header. Do not guess: the first forwarded request is logged with the chain
# received and the address selected.
#OMNISSA_TRUSTED_PROXY_HOPS=0
